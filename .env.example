# このファイルをコピーして .env にリネームし、値を設定してください（.env は git に含めない）

# Google AI Studio の API キー（USE_VERTEX_AI=0 のとき、またはフォールバック用）
GEMINI_API_KEY=

# Firebase / Firestore（REST で users/{uid} を読むとき）
FIREBASE_PROJECT_ID=

# --- Vertex AI（推奨: Studio の Imagen 日次枠とは別のクォータ）---
# 1 にすると API キーがあっても Vertex を優先（api/gemini.php の resolveGeminiAuth）
USE_VERTEX_AI=1
# GCP のプロジェクト ID（Firebase のプロジェクト ID と同じことが多い）
GOOGLE_CLOUD_PROJECT=
# Imagen が利用可能なリージョン（例: us-central1）
VERTEX_AI_LOCATION=us-central1
# 任意（既定: imagen-4.0-generate-001）
# IMAGEN_MODEL=imagen-4.0-generate-001
